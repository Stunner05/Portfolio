
generator client {
  provider = "prisma-client-js"
  //  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

}

enum Status {
  COMPLETED
  IN_PROGRESS
  PLANNED
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  year        Int          // or String if you want "2025" as text
  tech        String[]
  image       String[]
  demo        String
  github      String @unique
  status      Status
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages Message[]
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  content   String
  createdAt DateTime @default(now())
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])
}


model Admin {
  id        String   @id @default(cuid())
  email     String   @unique      // Ensure no duplicate admin accounts
  password  String
  name      String?               // Optional, can store admin name if desired
  createdAt DateTime @default(now())
}

model Visits  {
  id Int @id @default(autoincrement())
  ipAddress String?
  userAgent String?
  Page String
  createdAt  DateTime @default(now())
}